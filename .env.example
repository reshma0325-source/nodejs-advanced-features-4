# Port the HTTP server listens on. Cloud platforms inject their own PORT,
# so this value is mostly used for local development (defaults to 3013).
PORT=3013

# Runtime environment: development | production.
# Controls morgan format (dev vs combined) and winston console colorisation.
NODE_ENV=development

# Minimum winston log level that is written: error | warn | info | http | verbose | debug | silly.
# With LOG_LEVEL=info, debug entries are filtered out.
LOG_LEVEL=info

# Directory (relative to the project root) where winston and morgan write their log files.
LOG_DIR=logs